{
  "name": "hy3n-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/functions.js",
  "types": "dist-types/routers.d.ts",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:functions": "esbuild src/functions.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist-types",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@trpc/server": "11.19.0",
    "axios": "1.20.0",
    "dotenv": "^16.6.1",
    "express": "4.22.3",
    "firebase-admin": "14.5.0",
    "firebase-functions": "7.4.0",
    "nodemailer": "10.1.0",
    "superjson": "^1.13.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.3",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "@fastify/busboy": "3.2.2",
    "body-parser": "1.20.6",
    "qs": "6.16.0"
  }
}
